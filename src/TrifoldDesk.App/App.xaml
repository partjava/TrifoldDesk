<Application x:Class="TrifoldDesk.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <Style TargetType="ToolTip"><Setter Property="Background" Value="#F1F3F5"/><Setter Property="Foreground" Value="#202830"/><Setter Property="Padding" Value="10,7"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="#202830" TextWrapping="Wrap" MaxWidth="560"/></DataTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ContextMenu"><Setter Property="Background" Value="#F1F3F5"/><Setter Property="Foreground" Value="#202830"/><Setter Property="BorderBrush" Value="#9CAAB5"/></Style>
    <Style TargetType="MenuItem"><Setter Property="Foreground" Value="#202830"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="9,5"/><Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="#202830"/></DataTemplate></Setter.Value></Setter><Style.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#202830"/></Style></Style.Resources></Style>
    <SolidColorBrush x:Key="Ink" Color="#F0F7FA"/>
    <SolidColorBrush x:Key="Muted" Color="#B8C9D2"/>
    <SolidColorBrush x:Key="Accent" Color="#00E5FF"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#12FFFFFF"/>
      <Setter Property="BorderBrush" Value="#30FFFFFF"/><Setter Property="Padding" Value="12,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border><ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#25FFFFFF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#4000E5FF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ProgressBar"><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="Background" Value="#18FFFFFF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="4"/><Setter Property="Maximum" Value="100"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,9"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,6,0,12"/><Setter Property="Padding" Value="6"/></Style>
  </Application.Resources>
</Application>
