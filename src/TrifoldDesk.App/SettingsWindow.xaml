<Window x:Class="TrifoldDesk.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrifoldDesk · 设置" Width="500" Height="660" MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#E0E4E8" ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
 <Window.Resources>
  <DataTemplate x:Key="SettingsChoice"><TextBlock Text="{Binding Name}" Foreground="#233249"/></DataTemplate>
  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="Foreground" Value="#233249"/>
  </Style>
  <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="FontSize" Value="16"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="Foreground" Value="#516176"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="#A6FFFFFF"/>
   <Setter Property="BorderBrush" Value="#D9FFFFFF"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="12"/>
   <Setter Property="Padding" Value="16"/>
   <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
   <Setter Property="Foreground" Value="#233249"/>
   <Setter Property="Margin" Value="0,6"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#233249"/>
   <Setter Property="Background" Value="#EDF2F6"/>
   <Setter Property="Padding" Value="14,8"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.84"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.68"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <DockPanel Background="{StaticResource DialogSilverBackdrop}">
  <StackPanel DockPanel.Dock="Top" Margin="24,20,24,14">
   <TextBlock Text="设置" FontSize="25" FontWeight="SemiBold"/>
   <TextBlock Text="调整桌面外观、启动行为和设备监控。" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
  </StackPanel>
  <Border DockPanel.Dock="Bottom" Background="#99FFFFFF" BorderBrush="#D9FFFFFF" BorderThickness="0,1,0,0" Padding="24,12">
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="取消" IsCancel="True" Margin="0,0,8,0"/>
    <Button Content="保存设置" IsDefault="True" Click="SaveClick" Background="#87D5E0" Foreground="#153A47"/>
   </StackPanel>
  </Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="24,0,20,4">
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="桌面外观" Style="{StaticResource Section}"/>
      <DockPanel Background="{StaticResource DialogSilverBackdrop}">
       <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}" FontWeight="SemiBold"/>
       <TextBlock Text="三折桌面背景不透明度"/>
      </DockPanel>
      <Slider x:Name="OpacitySlider" Minimum="0.05" Maximum="0.55" TickFrequency="0.05" Margin="0,8,0,6"/>
      <TextBlock Text="只调整三页底色。启动台和程序坞使用独立的玻璃材质。" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
      <CheckBox x:Name="IdleCheck"><TextBlock Text="鼠标离开后，背景不透明度减半" Foreground="#233249"/></CheckBox>
      <CheckBox x:Name="AnimationCheck"><TextBlock Text="启用展开与收起动画" Foreground="#233249"/></CheckBox>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="玻璃效果" Style="{StaticResource Section}"/>
      <TextBlock Text="玻璃背景来源"/>
      <ComboBox x:Name="GlassBackdropCombo" SelectedValuePath="Mode" ItemTemplate="{StaticResource SettingsChoice}"
                AutomationProperties.Name="玻璃背景来源" Margin="0,6,0,6"/>
      <TextBlock Text="仅桌面背景为实验功能，部分动态壁纸不支持，将显示备用底色。当前屏幕画面可能包含其他软件窗口。"
                 Style="{StaticResource Hint}"/>
      <CheckBox x:Name="RemoteGlassCheck"><TextBlock Text="手动开启远控兼容模式" Foreground="#233249"/></CheckBox>
      <TextBlock Text="远端看到窗口闪烁时可打开。兼容模式暂停玻璃采样，改用半透明底色。"
                 Style="{StaticResource Hint}"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="桌面与启动" Style="{StaticResource Section}"/>
      <CheckBox x:Name="DesktopCheck"><TextBlock Text="附着桌面（不兼容时回退底层窗口）" Foreground="#233249"/></CheckBox>
      <CheckBox x:Name="StartupCheck"><TextBlock Text="开机登录后自动运行" Foreground="#233249"/></CheckBox>
      <TextBlock Text="停靠显示器" Margin="0,8,0,0"/>
      <ComboBox x:Name="MonitorCombo" SelectedValuePath="Id" ItemTemplate="{StaticResource SettingsChoice}" Margin="0,6,0,0"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="设备监控" Style="{StaticResource Section}"/>
      <TextBlock Text="网速统计接口"/>
      <ComboBox x:Name="NetworkCombo" SelectedValuePath="Id" ItemTemplate="{StaticResource SettingsChoice}"/>
      <TextBlock Text="自动选择联网接口，也可指定 VPN 或物理网卡。" Style="{StaticResource Hint}"/>
      <TextBlock Text="监控显卡" Margin="0,12,0,0"/>
      <ComboBox x:Name="GpuCombo" SelectedValuePath="Id" ItemTemplate="{StaticResource SettingsChoice}"/>
      <TextBlock Text="温度和风扇读数可在系统概览的右键菜单中查看。" Style="{StaticResource Hint}"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="配置与诊断" Style="{StaticResource Section}"/>
      <WrapPanel>
       <Button x:Name="ProfileExportButton" Content="导出配置" Click="ProfileToolsClick" Margin="0,0,8,4"/>
       <Button x:Name="ProfileImportButton" Content="导入配置" Click="ProfileToolsClick" Margin="0,0,8,4"/>
       <Button x:Name="DiagnosticsButton" Content="启动诊断" Click="DiagnosticsClick" Margin="0,0,0,4"/>
      </WrapPanel>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
