<Window x:Class="TrifoldDesk.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TrifoldDesk · 设置" Width="430" Height="640" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#182633" ShowInTaskbar="False">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><TextBlock Text="透明材质已启用 · 真实背景模糊暂未提供" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10"/><Button Content="保存设置" IsDefault="True" Click="SaveClick"/></StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="让它融入你的桌面" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,20"/>
   <TextBlock Text="背景不透明度"/><Slider x:Name="OpacitySlider" Minimum="0.05" Maximum="0.55" TickFrequency="0.05" Margin="0,12,0,5"/><TextBlock Text="降低背景强度不会降低文字和图标清晰度" Foreground="{StaticResource Muted}" FontSize="11"/>
   <CheckBox x:Name="IdleCheck" Content="鼠标离开后进入透明待机"/>
   <CheckBox x:Name="AnimationCheck" Content="启用展开与收起动画"/>
   <CheckBox x:Name="StartupCheck" Content="开机登录后自动运行"/>
   <TextBlock Text="停靠显示器" Margin="0,14,0,0"/><ComboBox x:Name="MonitorCombo" SelectedValuePath="Id"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#202830"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
   <TextBlock Text="网速统计接口"/><ComboBox x:Name="NetworkCombo" SelectedValuePath="Id"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#202830"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
   <TextBlock Text="自动模式选择一个有网关的联网接口；可手动选择 VPN 或物理网卡，避免多网卡重复汇总。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
