  <ItemGroup><ProjectReference Include="../TrifoldDesk.Core/TrifoldDesk.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/AppIcon.ico" /></ItemGroup>
</Project>
