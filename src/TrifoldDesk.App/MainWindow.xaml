<Window x:Class="TrifoldDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TrifoldDesk" Width="1440" Height="900" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="False"
 MouseEnter="PanelMouseEnter" MouseLeave="PanelMouseLeave" Closing="WindowClosing">
 <Window.Resources>
  <Style x:Key="GlassPanel" TargetType="Border"><Setter Property="Background" Value="{DynamicResource GlassFill}"/><Setter Property="BorderBrush" Value="#35FFFFFF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="0"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/><Setter Property="Background" Value="#16000000"/><Setter Property="BorderBrush" Value="#35FFFFFF"/><Setter Property="Padding" Value="10"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><Grid><ScrollViewer x:Name="PART_ContentHost"/><TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{StaticResource Muted}" IsHitTestVisible="False" Visibility="Collapsed" FontSize="12"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <ToggleButton Background="#16FFFFFF" BorderBrush="#35FFFFFF" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10"><TextBlock Text="⌄" HorizontalAlignment="Right"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
   <ContentPresenter Margin="10,8,28,8" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
   <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#F0203442" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="9" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" Margin="5"/></ScrollViewer></Border></Popup>
  </Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#3500E5FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" CornerRadius="10" Background="#12FFFFFF" Padding="22,11" Margin="0,0,6,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#3800E5FF"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True"/><Border Grid.Row="1" Margin="0,20,0,0"><ContentPresenter ContentSource="SelectedContent"/></Border></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <DataTemplate x:Key="ShortcutTemplate">
   <Button Width="104" Height="108" Margin="5,7" Padding="5" Background="Transparent" BorderBrush="Transparent" ToolTip="{Binding Tooltip}" Click="ShortcutClick" PreviewMouseLeftButtonDown="LibraryShortcutPressed" PreviewMouseMove="LibraryShortcutMove" ContextMenuOpening="ShortcutMenuOpening" ContextMenuClosing="ShortcutMenuClosing">
    <Button.ContextMenu><ContextMenu><MenuItem Header="打开" Click="MenuOpen"/><MenuItem Header="重命名" Click="MenuRename"/><MenuItem Header="修改分组" Click="MenuGroup"/><MenuItem Header="上移一位" Tag="-1" Click="MenuReorder"/><MenuItem Header="下移一位" Tag="1" Click="MenuReorder"/><MenuItem Header="打开所在位置" Click="MenuShowFolder"/><MenuItem Header="重新定位…" Click="MenuRelocate"/><Separator/><MenuItem Header="从面板移除" Click="MenuRemove"/></ContextMenu></Button.ContextMenu>
    <StackPanel><Grid Width="48" Height="48"><Border Background="#12FFFFFF" CornerRadius="12"/><TextBlock Text="◇" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#99FFFFFF"/><Image Source="{Binding Icon}" Width="48" Height="48"/></Grid><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextAlignment="Center" FontSize="13" Margin="0,10,0,0"/><TextBlock Text="路径失效" Foreground="#FFBFA1" FontSize="10" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
   </Button>
  </DataTemplate>
  <DataTemplate x:Key="GroupHeader"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="8,16,0,6"/></DataTemplate>
 </Window.Resources>
 <Grid ClipToBounds="True">
  <Grid x:Name="PanelRoot" Margin="0" RenderTransformOrigin="1,0.5">
   <Grid.RenderTransform><TranslateTransform x:Name="PanelTranslation"/></Grid.RenderTransform>
   <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="0"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="0"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource GlassPanel}" AllowDrop="True" Tag="0" DragEnter="PanelDragEnter" DragOver="PanelDragEnter" DragLeave="PanelDragLeave" Drop="PanelDrop">
    <DockPanel><ScrollViewer DockPanel.Dock="Bottom" MaxHeight="460" VerticalScrollBarVisibility="Hidden" Margin="24,0,24,12"><StackPanel x:Name="LeftWidgetHost"/></ScrollViewer><Grid x:Name="AppsLibraryPanel" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Visibility="Collapsed"/>
     <TextBox Tag="搜索应用、路径或分组" Grid.Row="1" Text="{Binding AppsSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索应用名称、路径或分组" Margin="0,22,0,10"/>
     <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="AppGroupCombo" ItemsSource="{Binding Groups}" SelectedIndex="{Binding AppGroupIndex, Mode=TwoWay}" Margin="0,0,8,0" MinWidth="100"/><ComboBox Grid.Column="1" Tag="0" SelectionChanged="SortChanged" SelectedIndex="0" Margin="0"><ComboBoxItem Content="手动顺序"/><ComboBoxItem Content="名称升序"/><ComboBoxItem Content="名称降序"/></ComboBox></Grid>
     <Grid Grid.Row="3"><TextBlock Text="＋ 拖入应用或快捷方式" TextAlignment="Center" Foreground="{StaticResource Muted}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Apps.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding AppsView}" ItemTemplate="{StaticResource ShortcutTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.GroupStyle><GroupStyle HeaderTemplate="{StaticResource GroupHeader}"><GroupStyle.Panel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></GroupStyle.Panel></GroupStyle></ItemsControl.GroupStyle></ItemsControl></ScrollViewer>
     </Grid>
     <Grid Grid.Row="4" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding AppCountText}" VerticalAlignment="Center" Style="{StaticResource Caption}"/><Button Grid.Column="1" Content="＋ 添加应用" Tag="0" Click="AddClick"/></Grid>
    </Grid>
   </DockPanel></Border>

   <Border Grid.Column="2" Style="{StaticResource GlassPanel}" AllowDrop="True" Tag="1" DragEnter="PanelDragEnter" DragOver="PanelDragEnter" DragLeave="PanelDragLeave" Drop="PanelDrop">
    <DockPanel><ScrollViewer DockPanel.Dock="Bottom" MaxHeight="460" VerticalScrollBarVisibility="Hidden" Margin="24,0,24,12"><StackPanel x:Name="MiddleWidgetHost"/></ScrollViewer><Grid x:Name="ProjectsLibraryPanel" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Visibility="Collapsed"/>
     <TextBox Tag="搜索项目、文档或脚本" Grid.Row="1" Text="{Binding ProjectsSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索资料名称、路径或分组" Margin="0,22,0,10"/>
     <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ProjectGroupCombo" ItemsSource="{Binding Groups}" SelectedIndex="{Binding ProjectGroupIndex, Mode=TwoWay}" Margin="0,0,8,0" MinWidth="100"/><ComboBox Grid.Column="1" Tag="1" SelectionChanged="SortChanged" SelectedIndex="0" Margin="0"><ComboBoxItem Content="手动顺序"/><ComboBoxItem Content="名称升序"/><ComboBoxItem Content="名称降序"/></ComboBox></Grid>
     <Grid Grid.Row="3"><TextBlock Text="◇ 拖入项目、文档或脚本" TextAlignment="Center" Foreground="{StaticResource Muted}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Projects.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding ProjectsView}" ItemTemplate="{StaticResource ShortcutTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.GroupStyle><GroupStyle HeaderTemplate="{StaticResource GroupHeader}"><GroupStyle.Panel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></GroupStyle.Panel></GroupStyle></ItemsControl.GroupStyle></ItemsControl></ScrollViewer>
     </Grid>
     <StackPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ProjectCountText}" Style="{StaticResource Caption}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="＋ 添加资料" Tag="1" Click="AddClick"/></Grid></StackPanel>
    </Grid>
   </DockPanel></Border>

   <Border Grid.Column="4" Style="{StaticResource GlassPanel}">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Visibility="Collapsed"/><Button Grid.Column="1" Content="收起 ›" Click="CollapseClick" VerticalAlignment="Center" Padding="10,8"/></Grid>
     <TabControl Grid.Row="1" x:Name="HubTabs" SelectionChanged="HubTabChanged">
      <TabItem x:Name="StatusPluginTab" Header="状态"><ScrollViewer VerticalScrollBarVisibility="Hidden"><StackPanel Margin="0,0,4,0">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border x:Name="CpuWidget" Background="#DD203442" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="CPU" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CpuText}" FontSize="30" Margin="0,8,0,10"/><ProgressBar Value="{Binding CpuValue, Mode=OneWay}"/></StackPanel></Border>
        <Border x:Name="MemoryWidget" Grid.Column="2" Background="#DD203442" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="物理内存" Style="{StaticResource Caption}"/><TextBlock Text="{Binding MemoryPercent}" FontSize="30" Margin="0,8,0,10"/><ProgressBar Value="{Binding MemoryValue, Mode=OneWay}"/><TextBlock Text="{Binding MemoryText}" Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel></Border>
       </Grid>
       <Border x:Name="NetworkWidget" Background="#DD203442" CornerRadius="14" Padding="16" Margin="0,12,0,20"><StackPanel><TextBlock Text="网络速率" Style="{StaticResource Caption}"/><Grid Margin="0,8,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding DownloadText}" FontSize="21" Foreground="{StaticResource Accent}"/><TextBlock Grid.Column="1" Text="{Binding UploadText}" FontSize="21"/></Grid><TextBlock Text="{Binding NetworkName}" Style="{StaticResource Caption}"/></StackPanel></Border>
       <TextBlock x:Name="DriveHeading" Text="{Binding DriveCountText}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <ItemsControl x:Name="DriveWidgets" ItemsSource="{Binding Drives}"><ItemsControl.ItemTemplate><DataTemplate>
        <Border Background="#12FFFFFF" CornerRadius="14" Padding="16" Margin="0,0,0,10"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Kind}" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="打开" Padding="10,6" IsEnabled="{Binding CanOpen}" Click="OpenDriveClick"/></Grid><ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Margin="0,12,0,10"><ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}"><Style.Triggers><DataTrigger Binding="{Binding LowSpace}" Value="True"><Setter Property="Foreground" Value="#FFBFA1"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><TextBlock Text="{Binding CapacityText}" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="管理"><Grid x:Name="ManagementContent"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBox Tag="搜索全部入口" Text="{Binding ManagementSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索全部应用与资料" Margin="0,0,0,10"/>
       <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" Style="{StaticResource Caption}"/><Button Grid.Column="1" Content="选择可见项" Click="SelectVisibleClick" Padding="10,6"/></Grid>
       <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden"><ItemsControl ItemsSource="{Binding ManagementView}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#12FFFFFF" CornerRadius="10" Padding="10" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,10,0" VerticalAlignment="Center"/><Image Grid.Column="1" Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,10,0"/><StackPanel Grid.Column="2"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"><Run Text="{Binding ScreenName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Group, Mode=OneWay}"/></TextBlock></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
       <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBox Tag="输入分组名，例如：开发、学习、比赛" x:Name="BatchGroupInput" ToolTip="输入分组名；留空表示未分组"/><Button Content="应用分组到所选入口" Click="BatchGroupClick" Margin="0,8,0,8"/><UniformGrid Columns="2"><Button Content="移到应用库" Tag="0" Click="BatchMoveClick" Margin="0,0,4,8"/><Button Content="移到资料库" Tag="1" Click="BatchMoveClick" Margin="4,0,0,8"/><Button Content="批量移除" Click="BatchRemoveClick" Margin="0,0,4,0"/><Button Content="取消选择" Click="ClearSelectionClick" Margin="4,0,0,0"/></UniformGrid></StackPanel>
      </Grid></TabItem>
      <TabItem x:Name="ControlPluginTab" Header="控制"><ScrollViewer x:Name="ControlsContent" VerticalScrollBarVisibility="Hidden"><StackPanel Margin="0,0,4,0">
       <TextBlock Text="系统快捷设置" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <UniformGrid Columns="3">
        <Button Tag="ms-settings:network-wifi" Click="SystemSettingsClick" Margin="0,0,6,8" Padding="4,14"><StackPanel><TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="Wi-Fi" Margin="0,10,0,0" HorizontalAlignment="Center"/><TextBlock Text="打开设置" FontSize="9" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Button>
        <Button Tag="ms-settings:bluetooth" Click="SystemSettingsClick" Margin="0,0,6,8" Padding="4,14"><StackPanel><TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="蓝牙" Margin="0,10,0,0" HorizontalAlignment="Center"/><TextBlock Text="打开设置" FontSize="9" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Button>
        <Button Tag="ms-settings:network-airplanemode" Click="SystemSettingsClick" Margin="0,0,0,8" Padding="4,14"><StackPanel><TextBlock Text="&#xE709;" FontFamily="Segoe MDL2 Assets" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="飞行模式" Margin="0,10,0,0" HorizontalAlignment="Center"/><TextBlock Text="打开设置" FontSize="9" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Button>
        <Button Tag="ms-settings:easeofaccess" Click="SystemSettingsClick" Content="辅助功能 ↗" Margin="0,0,6,8" Padding="4,12"/>
        <Button Tag="ms-settings:powersleep" Click="SystemSettingsClick" Content="电源与节能 ↗" Margin="0,0,6,8" Padding="4,12"/>
        <Button Tag="ms-settings:easeofaccess-closedcaptioning" Click="SystemSettingsClick" Content="字幕设置 ↗" Margin="0,0,0,8" Padding="4,12"/>
       </UniformGrid>
       <Border Background="#12FFFFFF" CornerRadius="14" Padding="16" Margin="0,12,0,12"><StackPanel>
        <Grid><TextBlock Text="系统音量"/><TextBlock x:Name="VolumeLabel" HorizontalAlignment="Right" Text="读取中"/></Grid><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" ValueChanged="VolumeChanged" IsEnabled="False" Margin="0,12,0,8"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="MuteButton" Content="静音" Click="MuteClick" IsEnabled="False" Padding="10,6"/><Button Grid.Column="1" Content="声音设置 ↗" Tag="ms-settings:sound" Click="SystemSettingsClick" Padding="10,6" Margin="8,0,0,0"/></Grid>
       </StackPanel></Border>
       <Border Background="#12FFFFFF" CornerRadius="14" Padding="16" Margin="0,0,0,16"><StackPanel><Grid><TextBlock Text="屏幕亮度"/><TextBlock x:Name="BrightnessLabel" HorizontalAlignment="Right" Text="读取中" FontSize="12"/></Grid><Slider x:Name="BrightnessSlider" ValueChanged="BrightnessChanged" Minimum="0" Maximum="100" IsEnabled="False" PreviewMouseLeftButtonUp="BrightnessReleased" PreviewKeyUp="BrightnessKeyUp" Margin="0,12,0,8"/><Button Content="显示设置 ↗" Tag="ms-settings:display" Click="SystemSettingsClick" Padding="10,6"/></StackPanel></Border>
       <UniformGrid Columns="2"><Button Content="{Binding AwakeLabel}" Click="AwakeClick" Margin="0,0,6,8"/><Button Content="清空回收站" Click="RecycleClick" Margin="0,0,0,8"/><Button Content="任务栏与托盘 ↗" Tag="ms-settings:taskbar" Click="SystemSettingsClick" Margin="0,0,6,8"/><Button Content="桌面个性化 ↗" Tag="ms-settings:personalization" Click="SystemSettingsClick" Margin="0,0,0,8"/></UniformGrid>
       <Border Background="#12FFFFFF" CornerRadius="14" Padding="16" Margin="0,12,0,0"><StackPanel><TextBlock Text="{Binding ClockText}" FontSize="36"/><TextBlock Text="{Binding DateText}" Margin="0,6,0,8"/><TextBlock Text="{Binding BatteryText}" Foreground="{StaticResource Accent}"/></StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="桌面插件"><ScrollViewer VerticalScrollBarVisibility="Hidden"><StackPanel x:Name="RightWidgetHost" Margin="0,8,4,0"/></ScrollViewer></TabItem></TabControl>
     <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Grid.Column="1" Content="＋ 插件库" Click="PluginLibraryClick" Padding="10,7"/></Grid>
    </Grid>
   </Border>
   <Canvas x:Name="WidgetCanvas" Grid.ColumnSpan="5" Margin="0" ClipToBounds="True"/>

  </Grid>
 </Grid>
</Window>
